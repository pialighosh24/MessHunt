# Mess Hunt Mobile (Expo) Environment Variables
# Copy this file to .env for local development (do not commit .env).
# Use EXPO_PUBLIC_* for values needed in the app runtime.

# Backend API base URL (must include the /api prefix used by the Express backend).
# For Expo Go on a physical Android device, use your development computer's current LAN IPv4 address
# (not localhost/127.0.0.1). Ensure phone and computer are on the same network.
# Example: EXPO_PUBLIC_API_BASE_URL=http://192.168.1.10:5000/api
EXPO_PUBLIC_API_BASE_URL=

EXPO_PUBLIC_APP_NAME=Mess Hunt
EXPO_PUBLIC_APP_TAGLINE=Find Your Perfect Mess
