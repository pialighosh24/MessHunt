# Mess Hunt Backend Environment Variables
# Copy this file to .env and fill in real values locally.
# Never commit .env and never share real credentials/connection strings in chat.

NODE_ENV=development
PORT=5000

# Application mode:
# - local-demo : persistent file-backed local API (NO MongoDB connection, for demo)
# - mongo      : MongoDB/Mongoose mode (default behavior if unset)
APP_MODE=mongo

# MongoDB Atlas connection string (required only when APP_MODE=mongo)
# Example format:
# MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-host>/<database-name>?retryWrites=true&w=majority
MONGODB_URI=

# JWT configuration (required in both modes)
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=7d
JWT_ISSUER=mess-hunt-api

# CORS (comma-separated origins for owner/admin dashboards and local tools)
# If running both dashboards, include both ports (e.g. 5173,5174)
CORS_ORIGINS=http://localhost:5173,http://localhost:5174

# Local demo mode settings (used when APP_MODE=local-demo)
# Initial admin account is created only by explicit init script using these values.
LOCAL_DEMO_ADMIN_NAME=Mess Hunt Admin
LOCAL_DEMO_ADMIN_EMAIL=admin@messhunt.local
LOCAL_DEMO_ADMIN_PASSWORD=ChangeThisAdminPassword123
# Optional: seed clearly labeled demo/sample data only when store is empty (true/false)
LOCAL_DEMO_SEED_SAMPLE_DATA=true

# Uploads / Image storage (Cloudinary - MongoDB/future mode)
# Configure these locally in backend/.env only when using Cloudinary mode. Never commit real values.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Cloudinary folder for accommodation photos
CLOUDINARY_ACCOMMODATION_FOLDER=mess-hunt/accommodations

# Upload constraints (used in mongo/Cloudinary mode and as defaults where applicable)
UPLOAD_DIR=uploads
MAX_UPLOAD_SIZE_MB=5
MAX_PHOTOS_PER_ACCOMMODATION=10
